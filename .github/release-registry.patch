diff --git a/Cargo.toml b/Cargo.toml
index d291a97..466f889 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -1,9 +1,9 @@
 # Workspace root.
 #
 # This repository hosts the C ABI binding over the canonical Sidereon engine. The
-# engine itself lives in ONE canonical repository. Release candidates pin one
-# full Git commit; final releases consume the matching published
-# `sidereon-core` and `sidereon` crates. The modeling code is never vendored.
+# engine itself lives in ONE place: the published crates `sidereon-core` and
+# `sidereon` on crates.io. It is consumed as a registry dependency, never
+# vendored here, so there is a single source of truth for the modeling code.
 [workspace]
 resolver = "2"
 members = ["bindings/c"]
diff --git a/bindings/c/Cargo.toml b/bindings/c/Cargo.toml
index 431a19b..76a9363 100644
--- a/bindings/c/Cargo.toml
+++ b/bindings/c/Cargo.toml
@@ -18,15 +18,15 @@ crate-type = ["cdylib", "staticlib"]
 # The thin ergonomic engine surface this binding marshals to. No modeling logic
 # lives here: every solve delegates to a `sidereon` entry point, which in turn
 # delegates to `sidereon-core`. The numbers are exactly what the engine produces.
-# Candidate canonical engine surface, pinned to one full source commit.
-sidereon = { version = "3.0.2", git = "https://github.com/neilberkman/sidereon", rev = "47eaf24e39afa71168670664e88361ed41011bc2" }
-sidereon-core = { version = "3.0.2", git = "https://github.com/neilberkman/sidereon", rev = "47eaf24e39afa71168670664e88361ed41011bc2", features = ["mmap"] }
+# Published canonical engine surface.
+sidereon = { version = "=3.0.2" }
+sidereon-core = { version = "=3.0.2", features = ["mmap"] }
 serde_json = "1"
 serde = "1"
 # The generic data-driven trust-region least-squares engine the headline TRLS
 # entry points marshal to. Not re-exported by the `sidereon` facade, so it is a
 # direct dependency.
-trust-region-least-squares = { version = "0.11.0", git = "https://github.com/neilberkman/sidereon", rev = "47eaf24e39afa71168670664e88361ed41011bc2" }
+trust-region-least-squares = { version = "=0.11.0" }
 # `nalgebra` (pinned to the core's version) builds the dense `DMatrix` the
 # covariance/Hessian-trace primitives take by reference; this binding owns no
 # modeling math, it only marshals the caller's row-major buffer into the matrix
